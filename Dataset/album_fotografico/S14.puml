@startuml
skinparam classAttributeIconSize 0

class UTENTE {
  - NOME
  - PASSWORD
  - IDENTIFICAZIONE DELL'UTENTTI
}

class FOTOGRAFIA {
  - AUTORE
  - TITOLO
  --
  - IDENTIFICARE IL LUOGO  TRAMITE COORDINATE
}

class ALBUM {
  - CREATORE
}

class LUOGO {
  - LATITUDINE
  - LONGITUDINE
  - NOME MNEMONICO
}

enum Nome_Mnemonico {
  CITTA
  MONUMENTO
  LOCALE_PUBBLICO
}

class ALBUM_PERSONALE {
  - COMPORRE ALBUM AUTOMATICO CON LO STESSO LUOGO
}

class ALBUM_LOCALIZZATO {
  - COMPORRE ALBUM AUTOMATICO CON STESSO UTENTE
}
LUOGO -- Nome_Mnemonico
ALBUM_LOCALIZZATO -up-|> ALBUM
ALBUM_PERSONALE -up-|> ALBUM
UTENTE "*" -- "*" FOTOGRAFIA
FOTOGRAFIA "*" -- "*" ALBUM
FOTOGRAFIA "1" -- "0..1" LUOGO

@enduml